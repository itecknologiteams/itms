# ─── Shared / infrastructure ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (per-service logical databases live on one local cluster)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=itms
POSTGRES_PASSWORD=itms_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ (event bus)
RABBITMQ_URL=amqp://itms:itms_dev_password@localhost:5672
RABBITMQ_EXCHANGE=itms.events

# EMQX (MQTT — GPS tracker ingestion)
MQTT_URL=mqtt://localhost:1883

# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=itms_minio
S3_SECRET_KEY=itms_minio_password
S3_BUCKET=itms-dev

# Cross-service base URLs (used by services that call each other directly)
AUTH_BASE_URL=http://localhost:3001
DISPATCH_BASE_URL=http://localhost:3004
GEOFENCE_BASE_URL=http://localhost:3005
TRACKING_BASE_URL=http://localhost:3006

# RS256 keypair paths (generate with: npm run keys:gen). NEVER commit real keys.
# Every service verifies with the public key; only Auth also signs (private key).
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=itms-auth

# ─── Auth service ───────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_DB_NAME=auth_db
# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=1800
# In dev, OTPs are logged instead of sent via SMS. NEVER enable in production.
OTP_DEV_ECHO=true

# ─── Passenger service ──────────────────────────────────────────────────────
PASSENGER_SERVICE_PORT=3002
PASSENGER_DB_NAME=passenger_db

# ─── Driver service ─────────────────────────────────────────────────────────
DRIVER_SERVICE_PORT=3003
DRIVER_DB_NAME=driver_db

# ─── Dispatch service (Redis-only, no SQL database) ─────────────────────────
DISPATCH_SERVICE_PORT=3004

# ─── Geofence service ───────────────────────────────────────────────────────
GEOFENCE_SERVICE_PORT=3005
GEOFENCE_DB_NAME=geofence_db

# ─── Tracking service ───────────────────────────────────────────────────────
TRACKING_SERVICE_PORT=3006
TRACKING_DB_NAME=tracking_db
# Dev convenience: treat the MQTT topic segment as the vehicle id directly
# instead of looking it up from a tracker-device registry (see service README).
TRACKER_TOPIC_IS_VEHICLE_ID=true

# ─── Ride service ───────────────────────────────────────────────────────────
RIDE_SERVICE_PORT=3007
RIDE_DB_NAME=ride_db

# ─── Fare service ───────────────────────────────────────────────────────────
FARE_SERVICE_PORT=3008
FARE_DB_NAME=fare_db

# ─── Payment service ────────────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=3009
PAYMENT_DB_NAME=payment_db
# Real JazzCash/1LINK credentials pending (OPEN-3) — stub always succeeds.
PAYMENT_GATEWAY_MODE=stub

# ─── Document/Media service ─────────────────────────────────────────────────
DOCUMENT_SERVICE_PORT=3010
DOCUMENT_DB_NAME=document_db

# ─── Notification service ───────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=3011
NOTIF_DB_NAME=notif_db

# ─── Admin/Reporting service ────────────────────────────────────────────────
ADMIN_REPORTING_SERVICE_PORT=3012
REPORTING_DB_NAME=reporting_db
