# ─── Shared / infrastructure ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (per-service logical databases live on one local cluster)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=itms
POSTGRES_PASSWORD=itms_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ (event bus)
RABBITMQ_URL=amqp://itms:itms_dev_password@localhost:5672
RABBITMQ_EXCHANGE=itms.events

# EMQX (MQTT — GPS tracker ingestion)
MQTT_URL=mqtt://localhost:1883

# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=itms_minio
S3_SECRET_KEY=itms_minio_password
S3_BUCKET=itms-dev

# ─── Auth service ───────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_DB_NAME=auth_db
# RS256 keypair paths (generate with: npm run keys:gen). NEVER commit real keys.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=itms-auth
# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=1800
# In dev, OTPs are logged instead of sent via SMS. NEVER enable in production.
OTP_DEV_ECHO=true
