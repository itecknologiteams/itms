{
  "name": "itms",
  "version": "0.1.0",
  "private": true,
  "description": "Electric Taxi Management System — backend monorepo",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "libs/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint \"{libs,services}/**/*.ts\"",
    "format": "prettier --write \"{libs,services}/**/*.{ts,json}\"",
    "format:check": "prettier --check \"{libs,services}/**/*.{ts,json}\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "keys:gen": "bash scripts/gen-keys.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
