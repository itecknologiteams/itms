# Local dev: leave unset to fan out to individual services on their default
# ports (see next.config.js). Staging/production: set API_GATEWAY_URL to Kong.
# API_GATEWAY_URL=https://api.itms.example

# Demo mode: serves realistic mock data instead of calling the backend at all.
# Useful when no backend services are running (see src/lib/mock/README.md).
NEXT_PUBLIC_MOCK_MODE=true
